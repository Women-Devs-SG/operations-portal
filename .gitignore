# Secret environment variables (Service Account Keys, Tokens)
.env
.env.*
!.env.example

# Service account key files, but keep project manifests and the lockfile.
*.json
!package.json
!package-lock.json
!tsconfig.json
!netlify/**/*.json
# Demo fixtures are deliberately public — they hold only fictional events.
# Scoped to the *.demo.json suffix so a stray key file dropped in fixtures/
# stays ignored by the rule above.
!fixtures/*.demo.json

# Dependencies
node_modules/
.npm-cache/

# Netlify build output
.netlify/
# Generated by `netlify dev`; this project has no Deno edge functions.
deno.lock

# Vite build output
dist/

# OS metadata
.DS_Store
Thumbs.db

# OpenSpec CLI scaffolding for Claude Code: regenerated by `openspec init` /
# `openspec update` from the CLI. The tracked openspec/ directory is the source
# of truth; generated tool integrations are disposable.
.claude/commands/opsx/
.claude/skills/openspec-*/
