{
  "name": "wds-ops-portal",
  "version": "1.0.0",
  "description": "WDS Operations Portal with Google Drive, Sheets, and Telegram automation",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "predev": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "netlify dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "audit": "npm audit --omit=dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src lib netlify tests test",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "openspec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "googleapis": "^174.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fission-ai/openspec": "1.14.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "netlify-cli": "^23.13.5",
    "prettier": "^3.9.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.5"
  }
}
